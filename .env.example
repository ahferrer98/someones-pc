VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional but recommended once your collection grows past a couple dozen
# unique cards — the free pokemontcg.io tier is heavily rate-limited without
# a key. Get one at https://pokemontcg.io/
VITE_POKEMONTCG_API_KEY=

# Optional — enables the "Admin" tab (who's signed up, last sign-in, how much
# they've logged), visible only to whichever account has this exact email.
# See README's "Admin usage view" section before setting this.
VITE_ADMIN_EMAIL=

# Required only alongside VITE_ADMIN_EMAIL above. This is your Supabase
# project's service_role key (Settings → API) — it bypasses row-level
# security entirely, so it must NEVER be prefixed with VITE_ (that would ship
# it to every visitor's browser). Only api/admin-stats.js reads it, and only
# once deployed — there's no Vercel function under `vite dev`.
SUPABASE_SERVICE_ROLE_KEY=
